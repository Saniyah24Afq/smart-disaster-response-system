
const { app, BrowserWindow, dialog } = require("electron");
const { spawn } = require("child_process");

const PROJECT_ROOT =
  "C:\\Users\\Saniyah\\Desktop\\Smart Disaster Response System";

const FRONTEND_URL = "http://localhost:3000";

let mainWindow;

function runDockerCompose() {
  return new Promise((resolve, reject) => {
    const process = spawn("docker", ["compose", "up", "-d"], {
      cwd: PROJECT_ROOT,
      windowsHide: true,
      shell: false
    });

    let errorOutput = "";

    process.stderr.on("data", (data) => {
      errorOutput += data.toString();
    });

    process.on("error", (error) => {
      reject(error);
    });

    process.on("close", (code) => {
      if (code === 0) {
        resolve();
      } else {
        reject(
          new Error(
            errorOutput ||
              `Docker Compose exited with code ${code}`
          )
        );
      }
    });
  });
}

async function waitForFrontend() {
  for (let attempt = 0; attempt < 60; attempt++) {
    try {
      const response = await fetch(FRONTEND_URL);

      if (response.ok) {
        return true;
      }
    } catch (_) {
      // Frontend may still be starting.
    }

    await new Promise((resolve) => setTimeout(resolve, 1000));
  }

  return false;
}

function createWindow() {
  mainWindow = new BrowserWindow({
    width: 1440,
    height: 900,
    minWidth: 1000,
    minHeight: 650,
    title: "RESQ - Smart Disaster Response",
    autoHideMenuBar: true,
    backgroundColor: "#f7faf9",
    webPreferences: {
      nodeIntegration: false,
      contextIsolation: true,
      sandbox: true
    }
  });

  mainWindow.webContents.setWindowOpenHandler(({ url }) => {
    const { shell } = require("electron");

    if (url.startsWith("https://")) {
      shell.openExternal(url);
    }

    return { action: "deny" };
  });
}

app.whenReady().then(async () => {
  createWindow();

  try {
    await runDockerCompose();

    const ready = await waitForFrontend();

    if (!ready) {
      throw new Error(
        "RESQ frontend did not respond on port 3000 within 60 seconds."
      );
    }

    await mainWindow.loadURL(FRONTEND_URL);
  } catch (error) {
    await dialog.showMessageBox(mainWindow, {
      type: "error",
      title: "RESQ could not start",
      message: "RESQ could not connect to its Docker services.",
      detail:
        error.message +
        "\n\nPlease start Docker Desktop and verify this project folder:\n" +
        PROJECT_ROOT,
      buttons: ["OK"]
    });
  }
});

app.on("window-all-closed", () => {
  if (process.platform !== "darwin") {
    app.quit();
  }
});